# Obligatoria. Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
APP_BASE_URL=http://localhost:9000
# true solo si se entra por HTTPS
AUTH_COOKIE_SECURE=false

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_USERNAME=usuario@example.com
SMTP_PASSWORD=coloca-aqui-la-contrasena-real
SMTP_FROM=usuario@example.com
FOLLOWUP_DEFAULT_TO_EMAIL=equipo@example.com

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
