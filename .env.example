# Obligatoria. Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
APP_BASE_URL=http://localhost:9000
# true solo si se entra por HTTPS
AUTH_COOKIE_SECURE=false

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_USERNAME=usuario@example.com
SMTP_PASSWORD=coloca-aqui-la-contrasena-real
SMTP_FROM=usuario@example.com
# El mail de seguimiento va siempre a cotizador@cuencotech.com (fijo en el codigo).

# Dejar 1 worker: la base es SQLite (un solo archivo) y con un unico proceso hay
# un solo escritor, un solo hilo de recordatorios y una sola consulta al BNA.
# Para atender mas usuarios a la vez, subir los hilos, no los workers.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
